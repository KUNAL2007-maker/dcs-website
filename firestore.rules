rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /enrollments/{docId} {
      // A signed-in visitor may create an enrollment tied to their own account.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;

      // They may read back only their own enrollments.
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;

      // Nobody edits or deletes from the browser. Manage these in the
      // Firebase console or from a server using the Admin SDK.
      allow update, delete: if false;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
